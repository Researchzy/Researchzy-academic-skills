	<text xml:lang="en">
		<body>
			<div>
				<head n="1" coords="1,72.0,400.0,100.0,10.0">Introduction</head>
				<p coords="1,72.0,420.0,450.0,60.0">Sleep loss impairs attention <ref type="bibr" target="#b0" coords="1,300.0,420.0,20.0,9.0">[1]</ref> and memory <ref type="bibr" target="#b1" coords="1,350.0,420.0,20.0,9.0">[2,</ref><ref type="bibr" target="#b0" coords="1,370.0,420.0,20.0,9.0">1]</ref>. Rotating rosters are common <ref type="bibr">[9]</ref>.<note place="foot" n="1" coords="1,72.0,700.0,450.0,8.0">Rosters as of 2024.</note></p>
			</div>
			<div>
				<head n="2.1" coords="2,72.0,72.0,100.0,10.0">Cohort</head>
				<p coords="2,72.0,90.0,450.0,60.0">Recall fell by 12% after three consecutive night shifts (<ref type="bibr" target="#b1" coords="2,72.0,90.0,60.0,9.0">Lee et al. 2019</ref>).</p>
				<formula xml:id="formula_0" coords="2,72.0,160.0,300.0,12.0">r = a + b n<label>(1)</label></formula>
			</div>
			<figure type="table" xml:id="tab_0" coords="3,72.0,72.0,450.0,100.0">
				<head>Table 1 :</head>
				<label>1</label>
				<figDesc>Table 1: Recall by shift pattern.</figDesc>
				<table><row><cell>Pattern</cell><cell>Recall</cell></row><row><cell>Day</cell><cell>0.81</cell></row></table>
			</figure>
